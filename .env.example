# Optional local API port; default used by pnpm start.
PORT=4700

# Private persistent mount for both SQLite and user WAV uploads.
# ECHOMAP_DATA_DIRECTORY=/var/lib/echomap

# Hosted external mode requires PostgreSQL AND a private audio bucket.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/echomap?sslmode=verify-full
# ECHOMAP_AUDIO_BUCKET=echomap-audio
# AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH_STORAGE_ENDPOINT
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=SET_IN_HOSTING_SECRETS
# AWS_SECRET_ACCESS_KEY=SET_IN_HOSTING_SECRETS
